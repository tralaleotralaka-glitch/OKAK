# ===== «Шёпот» — настройки =====
# Скопируйте этот файл в .env и заполните нужные значения.
# Без настройки сервис работает в демо-режиме (SMS никуда не уходят).

# --- Провайдер SMS: demo | twilio | smsru ---
SMS_PROVIDER=demo

# --- Twilio (https://www.twilio.com) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=ваш_токен
# TWILIO_FROM=+15005550006        # номер/имя отправителя Twilio

# --- SMS.ru (https://sms.ru) ---
# SMSRU_API_ID=ваш_api_id
# SMSRU_TEST=0                    # 1 = тестовый режим (бесплатно, без реальной отправки)

# --- Подпись в конце каждого SMS (пусто = без подписи) ---
# SIGNATURE= — Анонимно через «Шёпот»

# --- Секрет вебхуков входящих SMS (рекомендуется в продакшене) ---
# WEBHOOK_KEY=длинная_случайная_строка

# --- Ограничения ---
# MAX_LEN=1000      # максимум символов в сообщении
# RATE_PHONE=5      # сообщений на один номер получателя в час
# RATE_IP=30        # сообщений с одного IP в час
